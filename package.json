{
  "name": "health-signage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/app.ts --bundle --format=esm --outfile=static/js/app.js",
    "dev": "npm run build && .venv/bin/python app.py",
    "start": "npm run build && .venv/bin/python serve_local.py",
    "test": "tsx --test tests/*.test.ts && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "service:install": "npm run build && .venv/bin/python scripts/service.py install",
    "service:start": ".venv/bin/python scripts/service.py start",
    "service:stop": ".venv/bin/python scripts/service.py stop",
    "service:restart": ".venv/bin/python scripts/service.py restart",
    "service:status": ".venv/bin/python scripts/service.py status",
    "service:uninstall": ".venv/bin/python scripts/service.py uninstall"
  },
  "dependencies": {
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0"
  }
}
